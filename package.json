{
  "name": "@kitsunekode/sweep",
  "version": "0.2.0",
  "description": "Safe, fast artifact cleanup CLI for any project tree",
  "keywords": [
    "artifacts",
    "build",
    "cleanup",
    "cli",
    "devtools",
    "monorepo",
    "node_modules"
  ],
  "homepage": "https://github.com/KitsuneKode/sweep#readme",
  "bugs": {
    "url": "https://github.com/KitsuneKode/sweep/issues"
  },
  "license": "MIT",
  "author": "KitsuneKode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitsuneKode/sweep.git"
  },
  "bin": {
    "sweep": "dist/sweep.js"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.7.2",
      "oxlint": "^0.13.0",
      "oxfmt": "^0.45.0",
      "bun-types": "latest",
      "commander": "^12.1.0",
      "picocolors": "^1.1.1",
      "ajv": "^8.18.0",
      "@opentui/core": "^0.2.3"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/sweep.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "clean": "turbo run clean",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "test": "turbo run test",
    "check": "turbo run check",
    "preflight": "turbo run preflight",
    "pack:preview": "npm pack --dry-run",
    "pack": "npm pack",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "version": "changeset version && bun run sync-engine-versions",
    "sync-engine-versions": "bun run scripts/sync-engine-versions.ts",
    "engine:build": "cargo build --release -p sweep-engine-cli",
    "engine:pack": "bun run packages/engine-native/scripts/pack.ts",
    "engine:verify": "bun run packages/engine-native/scripts/verify-binary.ts",
    "release": "bun run prepublishOnly && bun run scripts/publish-release.ts",
    "prepare": "husky || true",
    "prepublishOnly": "turbo run check build preflight"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@kitsunekode/sweep-cli": "workspace:*",
    "@kitsunekode/sweep-core": "workspace:*",
    "@kitsunekode/sweep-display": "workspace:*",
    "@kitsunekode/sweep-protocol": "workspace:*",
    "@kitsunekode/sweep-ui": "workspace:*",
    "bun-types": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.6.1"
  },
  "optionalDependencies": {
    "@kitsunekode/sweep-engine-darwin-64": "0.2.0",
    "@kitsunekode/sweep-engine-darwin-arm64": "0.2.0",
    "@kitsunekode/sweep-engine-linux-64": "0.2.0",
    "@kitsunekode/sweep-engine-linux-arm64": "0.2.0",
    "@kitsunekode/sweep-engine-windows-64": "0.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.3.12"
}
