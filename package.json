{
  "name": "sweep-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.7.2",
      "oxlint": "^0.13.0",
      "oxfmt": "^0.45.0",
      "bun-types": "^1.3.0",
      "commander": "^12.1.0",
      "picocolors": "^1.1.1",
      "ajv": "^8.18.0",
      "@opentui/core": "^0.2.16",
      "@opentui/react": "^0.2.16",
      "react": "^19.2.0",
      "@types/react": "^19.2.0",
      "turbo": "^2.6.1",
      "@changesets/cli": "^2.30.0",
      "@commitlint/cli": "^19.6.0",
      "@commitlint/config-conventional": "^19.6.0",
      "husky": "^9.1.7",
      "lint-staged": "^15.2.10"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "build": "turbo run build",
    "bundle": "bun run scripts/bundle.ts",
    "bundle:watch": "bun run scripts/bundle.ts all --watch",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "test": "turbo run test",
    "check": "turbo run check && bun run check:docs",
    "check:affected": "turbo run check --affected && bun run check:docs",
    "check:docs": "bun run scripts/check-doc-links.ts",
    "preflight": "turbo run preflight",
    "pack:preview": "npm pack -w @kitsunekode/sweep --dry-run",
    "pack": "npm pack -w @kitsunekode/sweep",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "version": "changeset version && bun run sync-engine-versions",
    "sync-engine-versions": "bun run scripts/sync-engine-versions.ts",
    "//#engine:build:debug": "cargo build -p sweep-engine-cli",
    "//#engine:build": "cargo build --release -p sweep-engine-cli",
    "engine:build": "cargo build --release -p sweep-engine-cli",
    "engine:pack": "bun run packages/engine-native/scripts/pack.ts",
    "engine:verify": "bun run packages/engine-native/scripts/verify-binary.ts",
    "//#rust:fmt": "cargo fmt --all",
    "//#rust:lint": "cargo clippy --workspace -- -D warnings",
    "//#rust:test": "cargo test --workspace",
    "rust:fmt": "cargo fmt --all",
    "rust:lint": "cargo clippy --workspace -- -D warnings",
    "rust:test": "cargo test --workspace",
    "rust:check": "cargo fmt --all --check && cargo clippy --workspace -- -D warnings && cargo test --workspace",
    "link:global": "bun run build && bun link --cwd apps/cli",
    "unlink:global": "bun unlink --cwd apps/cli",
    "relink:global": "bun unlink --cwd apps/cli && bun run link:global",
    "release": "bun run prepublishOnly && bun run scripts/publish-release.ts",
    "prepare": "husky || true",
    "prepublishOnly": "turbo run check build preflight"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@kitsunekode/sweep-core": "workspace:*",
    "bun-types": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,mdx}": "oxfmt --write",
    "*.{ts,tsx,js,mjs,cjs}": "oxlint --fix"
  },
  "packageManager": "bun@1.3.12"
}
