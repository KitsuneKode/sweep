{
  "name": "sweep-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.7.2",
      "oxlint": "^0.13.0",
      "oxfmt": "^0.45.0",
      "@types/bun": "^1.4.2",
      "commander": "^12.1.0",
      "picocolors": "^1.1.1",
      "ajv": "^8.18.0",
      "@opentui/core": "^0.2.16",
      "@opentui/react": "^0.2.16",
      "react": "^19.2.0",
      "@types/react": "^19.2.0",
      "turbo": "^2.11.5",
      "@changesets/cli": "^2.30.0",
      "@commitlint/cli": "^19.6.0",
      "@commitlint/config-conventional": "^19.6.0",
      "husky": "^9.1.7",
      "lint-staged": "^15.2.10"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "clean": "turbo run clean --filter \"@kitsunekode/*\"",
    "build": "turbo run build --filter \"@kitsunekode/*\"",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint --filter \"@kitsunekode/*\"",
    "fmt": "turbo run fmt --filter \"@kitsunekode/*\"",
    "test": "turbo run test --filter \"@kitsunekode/*\"",
    "check": "turbo run check --filter \"@kitsunekode/*\" && bun run check:docs",
    "check:affected": "turbo run check --affected --filter \"@kitsunekode/*\" && bun run check:docs",
    "check:docs": "bun run scripts/check-doc-links.ts",
    "fixtures:sync": "bun run scripts/sync-fixture-trees.ts",
    "fixtures:validate-goldens": "bun run scripts/validate-parity-goldens.ts",
    "preflight": "turbo run preflight",
    "pack:preview": "npm pack -w @kitsunekode/sweep --dry-run",
    "pack": "npm pack -w @kitsunekode/sweep",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "version": "changeset version && bun run sync-engine-versions",
    "sync-engine-versions": "bun run scripts/sync-engine-versions.ts",
    "bootstrap:npm-trust": "bun run scripts/bootstrap-npm-trusted-publishing.ts",
    "engine:build:debug": "turbo run \"sweep-engine-cli#build\"",
    "engine:build": "turbo run \"sweep-engine-cli#build:release\"",
    "engine:pack": "bun run packages/engine-native/scripts/pack.ts",
    "engine:verify": "bun run packages/engine-native/scripts/verify-binary.ts",
    "engine:inspect": "bun run packages/engine-native/scripts/inspect-binary.ts",
    "rust:fmt": "turbo run \"sweep-rust#format\"",
    "rust:fmt-check": "turbo run \"sweep-rust#fmt:check\"",
    "rust:lint": "turbo run \"sweep-rust#lint\"",
    "rust:test": "turbo run \"sweep-rust#test\"",
    "rust:check": "turbo run \"sweep-rust#fmt:check\" \"sweep-rust#lint\" \"sweep-rust#test\"",
    "link:global": "bun run build && bun link --cwd apps/cli",
    "unlink:global": "bun unlink --cwd apps/cli",
    "relink:global": "bun unlink --cwd apps/cli && bun run link:global",
    "release": "bun run prepublishOnly && bun run scripts/publish-release.ts",
    "prepare": "husky || true",
    "prepublishOnly": "turbo run check build preflight --filter \"@kitsunekode/*\""
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@kitsunekode/sweep-core": "workspace:*",
    "@kitsunekode/sweep-protocol": "workspace:*",
    "@kitsunekode/sweep-test-fixtures": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,mdx}": "oxfmt --write",
    "*.{ts,tsx,js,mjs,cjs}": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    },
    "runtime": {
      "name": "bun",
      "version": ">=1.4.2",
      "onFail": "warn"
    }
  }
}
