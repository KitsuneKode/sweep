  "regressions": {
    "savedReplacement": {
      "before": "All four scan/save/load/apply reproductions deleted same-type replacement roots or candidates. Original renamed entries were retained, excluding inode reuse.",
      "after": "Both engines refuse replacement roots and report replacement candidates as failed; replacement sentinels survive.",
      "redLog": "/tmp/sweep-saved-identity-red.log",
      "greenLog": "/tmp/sweep-saved-identity-and-receipts-green.log"
    },
    "nativeDirectApply": "Direct library tests enforce saved root and leaf pins without a host validation fallback.",
    "legacy": "Old JSON remains readable; nonempty apply refuses missing approval snapshots. Pure buildPlan never invents snapshots for existing paths.",
    "olderNative": "A native engine with applyControl but no planIdentity capability is refused before its apply request body executes.",
    "wireAndUi": "Exact uint64 string identities survive JSON, stream, final rescan state, queued selection and focused-row plans; changed sizing identities are rejected.",
    "jsCoveredAliasReceipt": {
      "before": "A child alias reported unattempted after its selected parent had removed it.",
      "after": "Canonical receipt keys are frozen before mutations in both engines.",
      "redLog": "/tmp/sweep-js-alias-receipt-red.log",
      "greenLog": "/tmp/sweep-saved-identity-and-receipts-green.log"
    }
  },
