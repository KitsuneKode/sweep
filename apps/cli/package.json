{
  "name": "@kitsunekode/sweep",
  "version": "0.5.2",
  "description": "Safe, fast artifact cleanup CLI for any project tree",
  "keywords": [
    "artifacts",
    "build",
    "cargo",
    "clean",
    "cleanup",
    "cli",
    "devtools",
    "disk-space",
    "monorepo",
    "node-modules",
    "node_modules",
    "rust",
    "target",
    "tui"
  ],
  "homepage": "https://sweep.kitsunekode.in",
  "bugs": {
    "url": "https://github.com/KitsuneKode/sweep/issues"
  },
  "license": "MIT",
  "author": "KitsuneKode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitsuneKode/sweep.git"
  },
  "bin": {
    "sweep": "dist/sweep.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bin": "./src/bin.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "build:watch": "bun run ../../scripts/bundle.ts all --watch",
    "prepack": "bun run ./scripts/prepack.ts",
    "postpack": "bun run ./scripts/postpack.ts",
    "prepublishOnly": "bun run ./scripts/prepublish.ts",
    "transit": "exit 0",
    "preflight": "bun run ./scripts/preflight.ts",
    "dev": "bun run ./src/bin.ts",
    "test": "bun test src scripts",
    "clean": "bun run ./scripts/clean.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts",
    "fmt": "oxfmt src scripts",
    "fmt:check": "oxfmt --check src scripts"
  },
  "dependencies": {
    "@kitsunekode/sweep-core": "workspace:*",
    "@kitsunekode/sweep-display": "workspace:*",
    "@kitsunekode/sweep-protocol": "workspace:*",
    "@kitsunekode/sweep-ui": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@kitsunekode/sweep-typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": "^0.2.16"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@kitsunekode/sweep-engine-darwin-64": "0.5.2",
    "@kitsunekode/sweep-engine-darwin-arm64": "0.5.2",
    "@kitsunekode/sweep-engine-linux-64": "0.5.2",
    "@kitsunekode/sweep-engine-linux-arm64": "0.5.2",
    "@kitsunekode/sweep-engine-windows-64": "0.5.2"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
