{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/scripts/bundle.ts"
      ],
      "outputs": ["dist/**"]
    },
    "preflight": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "package.json", "dist/**"]
    }
  }
}
