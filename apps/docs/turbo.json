{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**"],
      "outputs": ["dist/**", ".vercel/output/**", ".tanstack/**", "src/routeTree.gen.ts"],
      "env": ["DOCS_SITE_URL", "VERCEL"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**"]
    },
    "dev": {
      "env": ["DOCS_SITE_URL"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**"]
    }
  }
}
