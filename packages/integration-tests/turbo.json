{
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["transit", "^build", "@kitsunekode/sweep#build", "sweep-engine-cli#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/**",
        "$TURBO_ROOT$/tests/fixtures/**",
        "$TURBO_ROOT$/crates/**"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tests/**", "$TURBO_ROOT$/tests/support/**"]
    },
    "fmt": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tests/**", "$TURBO_ROOT$/tests/support/**"]
    },
    "fmt:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tests/**", "$TURBO_ROOT$/tests/support/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tests/**", "$TURBO_ROOT$/tsconfig.json"]
    }
  }
}
