{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsunekode.dev/sweep/schemas/shared.schema.json",
  "title": "ProtocolSharedDefs",
  "$defs": {
    "riskTier": {
      "type": "string",
      "enum": ["safe", "caution", "dangerous", "blocked"]
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "includeDangerous"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["default", "safe", "all", "none"]
        },
        "includeDangerous": {
          "type": "boolean"
        }
      }
    },
    "pathFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "error"],
      "properties": {
        "path": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "enum": [
            "missing",
            "changed_symlink_state",
            "changed_entry_type",
            "outside_target",
            "permission_denied",
            "busy",
            "filesystem_error"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "scanCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "name",
        "estimatedBytes",
        "isSymlink",
        "entryType",
        "kind",
        "riskTier",
        "reasons",
        "selectedByDefault"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "estimatedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "isSymlink": {
          "type": "boolean"
        },
        "entryType": {
          "type": "string",
          "enum": ["file", "directory", "symlink"]
        },
        "kind": {
          "type": "string",
          "enum": [
            "node_modules",
            "dist",
            "build",
            "out",
            ".next",
            ".nuxt",
            ".svelte-kit",
            ".turbo",
            ".vite",
            ".parcel-cache",
            "target",
            "coverage",
            ".nyc_output",
            "tsbuildinfo",
            "custom"
          ]
        },
        "riskTier": {
          "$ref": "#/$defs/riskTier"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selectedByDefault": {
          "type": "boolean"
        }
      }
    },
    "scanCompletedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCount", "estimatedTotalBytes", "scannedDirs"],
      "properties": {
        "candidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedTotalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "scannedDirs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
