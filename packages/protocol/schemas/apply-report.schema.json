{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitsunekode.dev/sweep/schemas/apply-report.schema.json",
  "title": "ApplyReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "targetDir",
    "selectedCandidateIds",
    "deletedCount",
    "failedCount",
    "totalBytesFreed",
    "failedPaths"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1"
    },
    "targetDir": {
      "type": "string"
    },
    "selectedCandidateIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deletedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalBytesFreed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failedPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathFailure"
      }
    },
    "interrupted": {
      "type": "boolean"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "status"],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "status": {
            "enum": ["deleted", "failed", "covered", "unattempted"]
          },
          "coveredBy": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "pathFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "error"],
      "properties": {
        "path": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "enum": [
            "missing",
            "changed_symlink_state",
            "changed_entry_type",
            "outside_target",
            "protected_path",
            "permission_denied",
            "busy",
            "filesystem_error"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    }
  }
}
