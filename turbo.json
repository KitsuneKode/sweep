{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "cacheMaxAge": "14d",
  "cacheMaxSize": "1GB",
  "globalDependencies": [".oxfmtrc.json", ".oxlintrc.json"],
  "globalEnv": ["CI", "OS", "RUNNER_OS"],
  "globalPassThroughEnv": [
    "HOME",
    "PATH",
    "TMPDIR",
    "XDG_CONFIG_HOME",
    "APPDATA",
    "NO_COLOR",
    "FORCE_COLOR",
    "COLORFGBG",
    "SWEEP_ENGINE_PATH",
    "SWEEP_ENGINE_FROM_NPM",
    "CARGO_HOME",
    "RUSTUP_HOME",
    "RUSTFLAGS",
    "CARGO_ENCODED_RUSTFLAGS",
    "CARGO_BUILD_*",
    "CARGO_TARGET_*",
    "RUSTC",
    "RUSTC_WRAPPER",
    "RUSTC_WORKSPACE_WRAPPER",
    "RUSTUP_TOOLCHAIN",
    "CC",
    "CXX",
    "CFLAGS",
    "CXXFLAGS",
    "AR",
    "SDKROOT",
    "MACOSX_DEPLOYMENT_TARGET"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputLogs": "new-only",
      "tags": ["quality"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputLogs": "new-only",
      "tags": ["quality"]
    },
    "fmt": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "fmt:check": {
      "dependsOn": ["transit"],
      "outputLogs": "new-only",
      "tags": ["quality"]
    },
    "test": {
      "env": ["SWEEP_REQUIRE_RUST_TESTS"],
      "dependsOn": ["transit", "^build"],
      "outputLogs": "new-only",
      "cache": false,
      "tags": ["quality"]
    },
    "check": {
      "dependsOn": ["fmt:check", "lint", "test", "typecheck"],
      "cache": false,
      "tags": ["quality"]
    },
    "preflight": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "clean": {
      "cache": false
    },
    "sweep-rust#fmt:check": {
      "command": ["cargo", "fmt", "--all", "--check"],
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/rustfmt.toml"
      ],
      "tags": ["native", "quality"]
    },
    "sweep-rust#lint": {
      "command": ["cargo", "clippy", "--workspace", "--locked", "--", "-D", "warnings"],
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml"
      ],
      "env": [
        "RUSTFLAGS",
        "CARGO_ENCODED_RUSTFLAGS",
        "CARGO_BUILD_*",
        "CARGO_TARGET_*",
        "RUSTC",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "RUSTUP_TOOLCHAIN",
        "CC",
        "CXX",
        "CFLAGS",
        "CXXFLAGS",
        "AR",
        "SDKROOT",
        "MACOSX_DEPLOYMENT_TARGET"
      ],
      "tags": ["native"]
    },
    "sweep-engine-cli#build:release": {
      "command": ["cargo", "build", "--release", "--package", "sweep-engine-cli", "--locked"],
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml"
      ],
      "outputs": [
        "$TURBO_ROOT$/target/release/sweep-engine",
        "$TURBO_ROOT$/target/release/sweep-engine.exe"
      ],
      "env": [
        "RUSTFLAGS",
        "CARGO_ENCODED_RUSTFLAGS",
        "CARGO_BUILD_*",
        "CARGO_TARGET_*",
        "RUSTC",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "RUSTUP_TOOLCHAIN",
        "CC",
        "CXX",
        "CFLAGS",
        "CXXFLAGS",
        "AR",
        "SDKROOT",
        "MACOSX_DEPLOYMENT_TARGET"
      ],
      "tags": ["native"]
    },
    "sweep-engine-cli#build": {
      "cache": false,
      "tags": ["native"]
    },
    "sweep-engine#build": {
      "cache": false,
      "tags": ["native"]
    },
    "sweep-errors#build": {
      "cache": false,
      "tags": ["native"]
    },
    "sweep-fs#build": {
      "cache": false,
      "tags": ["native"]
    },
    "sweep-types#build": {
      "cache": false,
      "tags": ["native"]
    },
    "sweep-engine-cli#lint": {
      "cache": false,
      "tags": ["native", "quality"]
    },
    "sweep-engine#lint": {
      "cache": false,
      "tags": ["native", "quality"]
    },
    "sweep-errors#lint": {
      "cache": false,
      "tags": ["native", "quality"]
    },
    "sweep-fs#lint": {
      "cache": false,
      "tags": ["native", "quality"]
    },
    "sweep-types#lint": {
      "cache": false,
      "tags": ["native", "quality"]
    }
  },
  "concurrency": "4"
}
