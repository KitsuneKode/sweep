{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["CI", "OS", "RUNNER_OS"],
  "globalPassThroughEnv": ["HOME", "PATH", "TMPDIR", "SWEEP_ENGINE_PATH", "NO_COLOR"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["$TURBO_ROOT$/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "fmt": {
      "dependsOn": ["transit"],
      "cache": true
    },
    "test": {
      "dependsOn": ["transit", "^build"]
    },
    "check": {
      "dependsOn": ["fmt", "lint", "test", "typecheck"],
      "cache": false
    },
    "preflight": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
